{
  "name": "@ai-companion/app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build": "pnpm build:android && pnpm build:ios:simulator",
    "build:android": "./scripts/build-android.sh",
    "build:ios:device:unsigned": "./scripts/build-ios-device-unsigned.sh",
    "build:ios:simulator": "./scripts/build-ios-simulator.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test \".test-dist/**/*.test.js\""
  },
  "dependencies": {
    "@ai-companion/api-client": "workspace:*",
    "@ai-companion/core": "workspace:*",
    "@ai-companion/shared": "workspace:*",
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.2.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
